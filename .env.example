# ================= MODO 100% GRÁTIS (padrão) =================
# IA grátis: pegue a chave em aistudio.google.com (Get API key). Não pede cartão.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Se der erro de modelo, troque pelo nome atual de um modelo Flash listado no AI Studio
GEMINI_MODEL=gemini-flash-latest

# Publicação: manual = botão abre o X com o texto pronto (grátis). api = paga a API do X.
PUBLISH_MODE=manual

# ===== Telegram (@BotFather -> /newbot) - grátis =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================= OPCIONAIS (pagos) =================
# LLM_PROVIDER=anthropic usa o Claude (API paga)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# PUBLISH_MODE=api + DRY_RUN=false publica sozinho via API do X (paga)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
DRY_RUN=true

# ================= Comportamento =================
# No modo manual o link não custa nada, então pode deixar true.
INCLUDE_LINK=true
CHECK_INTERVAL_MIN=5
MIN_SCORE=4
MAX_DRAFTS_PER_HOUR=4
MAX_AGE_HOURS=6
POST_LANGUAGE=português do Brasil
PROFILE_STYLE=direto, informativo e com leve toque de humor
